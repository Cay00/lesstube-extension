{
  "manifest_version": 3,
  "name": "YouTube Customizer",
  "version": "0.1.0",
  "description": "Customize YouTube layout",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "css": ["style.css"],
      "run_at": "document_start"
    }
  ]
}